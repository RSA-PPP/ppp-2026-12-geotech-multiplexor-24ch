(version 1)

(rule "permitir_courtyard_grabador_en_dip40"
    (constraint courtyard_clearance (min -100mm))
    (condition "A.intersectsCourtyard('J_PROG1') && B.intersectsCourtyard('J_DIP40') || A.intersectsCourtyard('J_DIP40') && B.intersectsCourtyard('J_PROG1')")
)

(rule "permitir_pth_grabador_en_patio_dip40"
    (constraint hole_clearance (min 0mm))
    (condition "A.intersectsCourtyard('J_DIP40') && B.memberOfFootprint('J_PROG1') || B.intersectsCourtyard('J_DIP40') && A.memberOfFootprint('J_PROG1')")
)
